NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# DB-first automation (optional but recommended)
DATABASE_URL=
AUTOMATION_DB_SSL=true
AUTOMATION_REVALIDATE_SECRET=
AUTOMATION_TELEGRAM_BOT_TOKEN=
AUTOMATION_TELEGRAM_CHAT_ID=
AUTOMATION_X_ENABLED=false
AUTOMATION_X_ACCESS_TOKEN=
AUTOMATION_X_API_BASE_URL=https://api.x.com
AUTOMATION_SERPER_API_KEY=
AUTOMATION_BRAVE_SEARCH_API_KEY=

# SEO / GEO automation external sources
# GSC real pull
AUTOMATION_GSC_ENABLED=false
AUTOMATION_GSC_PROPERTY=sc-domain:cryptorebate.app
AUTOMATION_GSC_AUTH_MODE=service-account
AUTOMATION_GSC_SUBMIT_SITEMAPS=true
AUTOMATION_SITE_URL=https://cryptorebate.app
AUTOMATION_GSC_START_DAYS_AGO=28
AUTOMATION_GSC_ROW_LIMIT=1000
# Either provide the full service-account JSON...
AUTOMATION_GSC_SERVICE_ACCOUNT_JSON=
# ...or provide client email + private key
AUTOMATION_GSC_CLIENT_EMAIL=
AUTOMATION_GSC_PRIVATE_KEY=
# Refresh-token mode is also supported
AUTOMATION_GSC_CLIENT_ID=
AUTOMATION_GSC_CLIENT_SECRET=
AUTOMATION_GSC_REFRESH_TOKEN=

# Partner earnings sync examples
# Default operating model for this project is affiliate-first:
# - your main path is referral / affiliate
# - the recommended default sync source is a monthly CSV export from each exchange affiliate portal
# - API-native / broker-native modes are optional advanced integrations, not the default path
# Repeat this block for: BINANCE / OKX / BYBIT / BITGET / GATE / KUCOIN / HUOBI
# provider:
# - csv-portal  => monthly affiliate CSV / portal report export (recommended default)
# - generic     => direct JSON / CSV URL feed when an affiliate portal exposes one
# - okx-broker  => optional advanced OKX Broker API signed report flow
# - gate-api4   => optional advanced Gate APIv4 signed request to a broker/report endpoint
AUTOMATION_PARTNER_BINANCE_ENABLED=false
AUTOMATION_PARTNER_BINANCE_PROVIDER=csv-portal
AUTOMATION_PARTNER_BINANCE_URL=
AUTOMATION_PARTNER_BINANCE_FORMAT=csv
AUTOMATION_PARTNER_BINANCE_MODE=combined
AUTOMATION_PARTNER_BINANCE_METHOD=GET
AUTOMATION_PARTNER_BINANCE_AUTH_TYPE=none
AUTOMATION_PARTNER_BINANCE_AUTH_HEADER=X-API-Key
AUTOMATION_PARTNER_BINANCE_TOKEN=
AUTOMATION_PARTNER_BINANCE_KEY=
AUTOMATION_PARTNER_BINANCE_SECRET=
AUTOMATION_PARTNER_BINANCE_PASSPHRASE=
AUTOMATION_PARTNER_BINANCE_REPORT_KIND=
AUTOMATION_PARTNER_BINANCE_BROKER_TYPE=
AUTOMATION_PARTNER_BINANCE_WINDOW_DAYS=30
AUTOMATION_PARTNER_BINANCE_BODY_JSON=
AUTOMATION_PARTNER_BINANCE_FALLBACK_LOCALE=en
AUTOMATION_PARTNER_BINANCE_FALLBACK_PAGE_TYPE=official-site

# Recommended default for OKX: affiliate CSV export from the OKX affiliate portal
AUTOMATION_PARTNER_OKX_ENABLED=false
AUTOMATION_PARTNER_OKX_PROVIDER=csv-portal
AUTOMATION_PARTNER_OKX_FORMAT=csv
AUTOMATION_PARTNER_OKX_MODE=combined
AUTOMATION_PARTNER_OKX_METHOD=GET
AUTOMATION_PARTNER_OKX_URL=
AUTOMATION_PARTNER_OKX_AUTH_TYPE=none
AUTOMATION_PARTNER_OKX_AUTH_HEADER=X-API-Key
AUTOMATION_PARTNER_OKX_TOKEN=
AUTOMATION_PARTNER_OKX_KEY=
AUTOMATION_PARTNER_OKX_SECRET=
AUTOMATION_PARTNER_OKX_PASSPHRASE=
AUTOMATION_PARTNER_OKX_REPORT_KIND=
AUTOMATION_PARTNER_OKX_BROKER_TYPE=
AUTOMATION_PARTNER_OKX_WINDOW_DAYS=30
AUTOMATION_PARTNER_OKX_FALLBACK_LOCALE=en
AUTOMATION_PARTNER_OKX_FALLBACK_PAGE_TYPE=referral-code

# Recommended default for Gate: affiliate CSV export from the affiliate / portal dashboard
AUTOMATION_PARTNER_GATE_ENABLED=false
AUTOMATION_PARTNER_GATE_PROVIDER=csv-portal
AUTOMATION_PARTNER_GATE_URL=
AUTOMATION_PARTNER_GATE_FORMAT=csv
AUTOMATION_PARTNER_GATE_MODE=combined
AUTOMATION_PARTNER_GATE_METHOD=GET
AUTOMATION_PARTNER_GATE_AUTH_TYPE=none
AUTOMATION_PARTNER_GATE_AUTH_HEADER=X-API-Key
AUTOMATION_PARTNER_GATE_TOKEN=
AUTOMATION_PARTNER_GATE_KEY=
AUTOMATION_PARTNER_GATE_SECRET=
AUTOMATION_PARTNER_GATE_WINDOW_DAYS=30
AUTOMATION_PARTNER_GATE_FALLBACK_LOCALE=en
AUTOMATION_PARTNER_GATE_FALLBACK_PAGE_TYPE=official-site

# Optional advanced integrations:
# - set PROVIDER=okx-broker only if you later obtain OKX broker/API credentials
# - set PROVIDER=gate-api4 only if you later obtain Gate APIv4 broker/report credentials
